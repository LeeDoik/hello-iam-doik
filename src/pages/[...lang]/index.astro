---
import ExperienceList from "../../components/ExperienceList.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SkillsByProject from "../../components/SkillsByProject.astro";
import { localeFromParam, localeStaticPaths } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { Hero3D } from "../../islands/Hero3D";
import { ProjectFilter } from "../../islands/ProjectFilter";
import Base from "../../layouts/Base.astro";
import { getExperience, getProfile, getProjects, getSkills } from "../../lib/content";
import { pick } from "../../lib/localized";
import { ogImageUrl } from "../../lib/seo";
import { GROUP_UI_KEY, type SkillRow } from "../../lib/skills";

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = localeFromParam(Astro.params.lang);
const site = Astro.site?.href ?? "https://hello-iam-doik.vercel.app";
const profile = await getProfile();
const projects = await getProjects(locale);
const experience = await getExperience();
const skillRows: SkillRow[] = (await getSkills()).map((s) => ({
  id: s.data.id,
  name: s.data.name,
  group: s.data.group,
  builtWithIt: pick(s.data.builtWithIt, locale),
  projectSlugs: s.data.projects.map((p) => (p as { id: string }).id),
}));
const skillGroupById = new Map(skillRows.map((s) => [s.id, s.group]));
const cards = projects.map((p) => ({
  slug: p.slug,
  groups: [
    ...new Set(
      p.data.stack
        .map((id) => skillGroupById.get(id))
        .filter((g): g is NonNullable<typeof g> => g !== undefined),
    ),
  ],
}));
const filterGroups = (["frontend", "ai", "backend", "tooling"] as const)
  .filter((g) => cards.some((c) => c.groups.includes(g)))
  .map((g) => ({ id: g, label: t(locale, GROUP_UI_KEY[g]) }));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${Astro.site ?? ""}#me`,
  name: pick(profile.name, locale),
  email: profile.email,
  sameAs: [profile.links.github, profile.links.linkedin].filter((x): x is string => typeof x === "string"),
};
---

<Base
  {locale}
  path="/"
  title={t(locale, "site.title")}
  description={pick(profile.tagline, locale)}
  ogImage={ogImageUrl(site, locale)}
  {jsonLd}
>
  <section
    id="hero"
    class="bg-paper relative isolate mx-[calc(50%_-_50vw)] flex min-h-[60dvh] items-end overflow-hidden px-[max(1.5rem,calc(50vw_-_22.5rem))] pt-16 pb-16"
  >
    <Hero3D client:visible />
    <div
      class="bg-paper relative -m-6 max-w-[60ch] p-6 pr-8 shadow-[0_0_48px_32px_var(--color-paper)]"
    >
      <h1 class="text-5xl font-extrabold leading-[1.05] tracking-[-0.02em] md:text-7xl">{pick(profile.name, locale)}</h1>
      <p class="mt-5 text-xl font-medium md:text-2xl">{pick(profile.tagline, locale)}</p>
      <p class="text-ink-2 mt-6 text-base md:text-lg">{pick(profile.bio, locale)}</p>
      <a
        class="bg-accent text-accent-ink mt-8 inline-flex h-11 items-center rounded-sm px-5 text-base font-medium"
        href="#projects">{t(locale, "hero.cta.projects")}</a
      >
    </div>
  </section>

  <section id="projects" class="pt-16 pb-24 md:pb-32">
    <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "section.projects")}</h2>
    <ProjectFilter
      client:visible
      groups={filterGroups}
      cards={cards}
      labels={{ all: t(locale, "filter.all"), count: t(locale, "filter.count"), filterLabel: t(locale, "filter.label") }}
    />
    <div id="project-list" class="border-line mt-10 border-t">
      {projects.map((p) => <ProjectCard project={p} locale={locale} />)}
    </div>
  </section>

  <section id="skills" class="py-24 md:py-32">
    <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "section.skills")}</h2>
    <SkillsByProject rows={skillRows} locale={locale} />
  </section>

  <section id="experience" class="py-24 md:py-32">
    <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "section.experience")}</h2>
    <ExperienceList items={experience} locale={locale} />
  </section>

  <section id="contact" class="py-24 md:py-32">
    <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "section.contact")}</h2>
    <p class="mt-6 max-w-[65ch] text-base md:text-lg">
      <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={`mailto:${profile.email}`}>{profile.email}</a>
      <span class="text-ink-2 mx-2">·</span>
      <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={profile.links.github}>GitHub</a>
    </p>
  </section>
</Base>
