---
import ExperienceList from "../../components/ExperienceList.astro";
import { localeFromParam, localeStaticPaths } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import { getExperience, getFeaturedProjects, getProfile } from "../../lib/content";
import { formatPeriod } from "../../lib/dates";
import { pick } from "../../lib/localized";

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = localeFromParam(Astro.params.lang);
const profile = await getProfile();
const projects = await getFeaturedProjects(locale);
const experience = await getExperience();
---

<Base
  {locale}
  path="/resume/"
  title={`${t(locale, "nav.resume")} · ${pick(profile.name, locale)}`}
  description={pick(profile.tagline, locale)}
>
  <article class="py-16 print:py-0 md:py-24">
    <header class="flex items-start justify-between gap-6">
      <div>
        <h1 class="text-4xl leading-[1.15] font-bold tracking-tight md:text-5xl print:text-3xl">{pick(profile.name, locale)}</h1>
        <p class="mt-3 text-lg">{pick(profile.tagline, locale)}</p>
        <p class="text-ink-2 mt-4 text-sm">{profile.email}</p>
        <p class="text-ink-2 text-sm">{profile.links.github}</p>
        <p class="text-ink-2 text-sm">{pick(profile.location, locale)}</p>
      </div>
      <button
        data-print
        class="no-print bg-accent text-accent-ink inline-flex h-9 shrink-0 items-center rounded-sm px-3 text-sm font-medium"
        type="button"
      >
        {t(locale, "resume.print")}
      </button>
    </header>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "section.projects")}</h2>
    <ul class="mt-8 space-y-6">
      {
        projects.map((p) => (
          <li>
            <p class="font-semibold">
              {pick(p.data.title, locale)}{" "}
              <span class="text-ink-2 text-sm font-normal tabular-nums">
                {formatPeriod(p.data.period.from, p.data.period.to, locale)}
              </span>
            </p>
            <p class="mt-1 max-w-[65ch] text-sm">{pick(p.data.summary, locale)}</p>
            <p class="text-ink-2 mt-1 max-w-[65ch] text-sm">{pick(p.data.role.owned, locale)}</p>
            <p class="text-ink-2 mt-1 text-sm">{p.data.links.repo ?? p.data.links.live ?? t(locale, "project.repoPrivate")}</p>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "section.experience")}</h2>
    <ExperienceList items={experience} {locale} />
  </article>
  <script>
    document.querySelector<HTMLButtonElement>("[data-print]")?.addEventListener("click", () => window.print());
  </script>
</Base>
