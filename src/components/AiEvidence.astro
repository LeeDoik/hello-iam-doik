---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { pick } from "../lib/localized";

interface Props {
  ai: NonNullable<CollectionEntry<"projects">["data"]["ai"]>;
  locale: Locale;
}
const { ai, locale } = Astro.props;
// aiSchema도 screenSchema와 같은 이유로 architecture 필드가 느슨하게(unknown) 추론된다.
// 콘텐츠 레이어가 실제로 만들어 주는 값은 ImageMetadata다.
const architecture = ai.architecture as unknown as ImageMetadata | undefined;
const th = "border-line border-b px-2 py-2 text-left align-top whitespace-nowrap";
const td = "border-line border-b px-2 py-2 align-top";
// 숫자·범위·단위만 있는 값은 한 줄로 고정한다("83–100%"가 "83–"/"100%"로 쪼개지지 않게). 문장은 그대로 접는다.
const isNumeric = (v: string) => /^[\d.,%–\-\s초ms]+$/.test(v);
---

<section class="mt-16">
  <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "ai.title")}</h2>
  <p class="text-ink-2 mt-4 text-sm">
    {t(locale, "ai.models")}: {ai.models.map((m) => <code class="mr-2">{m}</code>)}
  </p>
  {
    ai.promptFile && (
      <p class="text-sm">
        <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={ai.promptFile}>
          {t(locale, "ai.prompt")}
        </a>
      </p>
    )
  }
  {architecture && (
    <Image src={architecture} alt={t(locale, "ai.architectureAlt")} class="border-line mt-6 w-full rounded-sm border" />
  )}
  {
    ai.evals.length > 0 && (
      <div class="scroll-x -mx-6 mt-6 px-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:mx-0 sm:px-0" tabindex="0" role="region" aria-label={t(locale, "ai.evals")}>
        {/* tabindex/role/aria-label: 가로 스크롤 영역은 키보드로도 닿아야 한다(axe scrollable-region-focusable). */}
        {/* [overflow-wrap:normal]: html의 anywhere가 표 자동 레이아웃의 최소 너비를 글자 단위로 만들어 셀을 짓눌러 버린다. 표는 단어 단위로 재고, 넘치면 래퍼가 스크롤한다. */}
        <table class="w-full text-sm tabular-nums [overflow-wrap:normal]">
          <caption class="sr-only">{t(locale, "ai.evals")}</caption>
          <thead>
            <tr>
              <th scope="col" class={th}>{t(locale, "ai.evals")}</th>
              <th scope="col" class={th}>n</th>
              <th scope="col" class={th}>baseline</th>
              <th scope="col" class={th}>final</th>
              <th scope="col" class={th}>{t(locale, "ai.judge")}</th>
            </tr>
          </thead>
          <tbody>
            {ai.evals.map((e) => (
              <tr>
                <td class:list={[td, "whitespace-nowrap"]}>
                  {e.name} ({e.metric})
                </td>
                <td class:list={[td, "whitespace-nowrap"]}>{e.n}</td>
                <td class:list={[td, "whitespace-nowrap"]}>{e.baseline}</td>
                <td class:list={[td, isNumeric(e.final) ? "whitespace-nowrap" : "min-w-[16rem]"]}>{e.final}</td>
                <td class:list={[td, "whitespace-nowrap"]}>{e.judge}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  <p class="text-ink-2 mt-4 text-sm">
    {
      ai.costPerRequest && (
        <>
          {t(locale, "ai.cost")}: {ai.costPerRequest} ·{" "}
        </>
      )
    }
    {ai.latencyP50 && <>{t(locale, "ai.latency")}: {ai.latencyP50}</>}
  </p>
  {
    ai.rejectedTradeoff && (
      <div class="mt-4 text-sm">
        <p>
          <strong>{t(locale, "ai.rejected")}:</strong> {pick(ai.rejectedTradeoff.option, locale)}
        </p>
        <p class="text-ink-2 mt-1 max-w-[65ch]">
          {pick(ai.rejectedTradeoff.reasonWithNumbers, locale)}
        </p>
      </div>
    )
  }
  {
    ai.failureModes.length > 0 && (
      <>
        <h3 class="mt-6 text-base font-semibold leading-[1.5]">{t(locale, "ai.failureModes")}</h3>
        <ul class="text-ink-2 mt-2 max-w-[65ch] list-disc pl-5 text-sm">
          {ai.failureModes.map((f) => <li>{pick(f, locale)}</li>)}
        </ul>
      </>
    )
  }
</section>
