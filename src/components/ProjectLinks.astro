---
import type { ProjectData } from "../content/schemas";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { pick } from "../lib/localized";

interface Props {
  links: ProjectData["links"];
  locale: Locale;
}
const { links, locale } = Astro.props;
---

<section class="mt-16">
  <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "project.links")}</h2>
  <ul class="mt-6 space-y-2 text-sm">
    {
      links.repo ? (
        <li>
          <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={links.repo}>
            {t(locale, "project.repo")}
          </a>
        </li>
      ) : (
        <li>{t(locale, "project.repoPrivate")}</li>
      )
    }
    {
      links.live && (
        <li>
          <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={links.live}>
            {t(locale, "project.live")}
          </a>
        </li>
      )
    }
    {
      links.demoVideo && (
        <li>
          <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={links.demoVideo}>
            {t(locale, "project.demoVideo")}
          </a>
        </li>
      )
    }
    {
      links.demoCredentials && (
        <li>
          {t(locale, "project.demoCredentials")}: <code>{links.demoCredentials.id}</code> / <code>{links.demoCredentials.password}</code>
        </li>
      )
    }
  </ul>
  {
    links.keyCommits.length > 0 && (
      <>
        <h3 class="mt-8 text-base font-semibold leading-[1.5]">{t(locale, "project.keyCommits")}</h3>
        <ul class="mt-3 space-y-3 text-sm">
          {links.keyCommits.map((c) => (
            <li>
              <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={c.url}>
                {pick(c.label, locale)}
              </a>
              <span class="text-ink-2 mt-1 block max-w-[65ch]">{pick(c.why, locale)}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>
