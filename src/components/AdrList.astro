---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/locales";
import { localePath } from "../lib/urls";
interface Props {
  adrs: CollectionEntry<"adrs">[];
  locale: Locale;
}
const { adrs, locale } = Astro.props;
---

<ol class="mt-3 space-y-2">
  {
    adrs.map((a) => (
      <li>
        <a class="underline" href={localePath(locale, `/colophon/${a.id}/`)}>
          {a.id.slice(0, 4)} · {a.data.title}
        </a>
        <span class="ml-2 rounded bg-black/5 px-2 text-xs">{a.data.status}</span>
        <span class="ml-2 text-xs opacity-60">{a.data.date}</span>
      </li>
    ))
  }
</ol>
