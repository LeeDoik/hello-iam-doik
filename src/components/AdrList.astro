---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/locales";
import { localePath } from "../lib/urls";
interface Props {
  adrs: CollectionEntry<"adrs">[];
  locale: Locale;
}
const { adrs, locale } = Astro.props;
---

<ol class="mt-6 space-y-4">
  {
    adrs.map((a) => (
      <li>
        <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={localePath(locale, `/colophon/${a.id}/`)}>
          {a.id.slice(0, 4)} · {a.data.title}
        </a>
        <span class="text-ink-2 ml-3 text-sm">{a.data.status}</span>
        <span class="text-ink-2 ml-3 text-sm tabular-nums">{a.data.date}</span>
      </li>
    ))
  }
</ol>
