---
import type { ProjectData } from "../content/schemas";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { pick } from "../lib/localized";

interface Props {
  role: ProjectData["role"];
  locale: Locale;
}
const { role, locale } = Astro.props;
---

<section class="mt-16">
  <h2 class="text-2xl font-semibold tracking-tight leading-[1.25] md:text-3xl">{t(locale, "project.role")}</h2>
  <p class="text-ink-2 mt-4 text-sm">{t(locale, "project.teamSize")}: {role.teamSize}</p>
  <p class="mt-2 max-w-[65ch]">{t(locale, "project.owned")}: {pick(role.owned, locale)}</p>
</section>
