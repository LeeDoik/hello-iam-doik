---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import type { DeployInfo } from "../lib/deploy";

interface Props {
  locale: Locale;
  email: string;
  github: string;
  deploy: DeployInfo;
}
const { locale, email, github, deploy } = Astro.props;
---

<footer
  class="border-line text-ink-2 mt-24 flex flex-wrap items-center justify-between gap-4 border-t px-6 py-10 text-sm"
>
  <div class="flex gap-4">
    <a class="decoration-accent underline-offset-4 hover:underline" href={github} rel="me">GitHub</a>
    <a class="decoration-accent underline-offset-4 hover:underline" href={`mailto:${email}`}>{email}</a>
  </div>
  <p>
    {t(locale, "footer.deployed")} {deploy.date} ·
    <a class="decoration-accent underline-offset-4 hover:underline" href={deploy.commitUrl}><code>{deploy.shortSha}</code></a>
  </p>
</footer>
