---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import type { DeployInfo } from "../lib/deploy";

interface Props {
  locale: Locale;
  email: string;
  github: string;
  deploy: DeployInfo;
}
const { locale, email, github, deploy } = Astro.props;
---

<footer class="border-line text-ink-2 mt-16 border-t text-sm">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-10">
    <div class="flex flex-wrap gap-x-4">
      <a class="inline-flex min-h-11 items-center decoration-accent underline-offset-4 hover:underline" href={github} rel="me">GitHub</a>
      <a class="inline-flex min-h-11 items-center decoration-accent underline-offset-4 hover:underline" href={`mailto:${email}`}>{email}</a>
    </div>
    <p class="inline-flex min-h-11 flex-wrap items-center">
      <span>{t(locale, "footer.deployed")} {deploy.date}</span><span class="mx-1">·</span><a
        class="inline-flex min-h-11 items-center decoration-accent underline-offset-4 hover:underline"
        href={deploy.commitUrl}><code>{deploy.shortSha}</code></a
      >
    </p>
  </div>
</footer>
