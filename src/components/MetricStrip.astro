---
import type { MetricData } from "../content/schemas";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { pick } from "../lib/localized";

interface Props {
  metrics: MetricData[];
  locale: Locale;
}
const { metrics, locale } = Astro.props;
// 열 수는 지표 수를 따른다(3개면 3열, 4개면 4열). auto-fit은 4번째 지표를 다음 줄에 혼자 남긴다.
const cols = metrics.length >= 4 ? "sm:grid-cols-4" : "sm:grid-cols-3";
// 각 지표는 부모 그리드의 행 5개(라벨·이전값·숫자·방법·근거)를 subgrid로 공유한다. 그래서 이전값이
// 없거나 라벨이 두 줄로 접혀도 같은 줄의 큰 숫자는 같은 높이에 놓인다. 행 간격은 gap 대신
// 셀의 pb-8(+ dl의 -mb-8)로 준다: subgrid 안쪽 행에는 부모 gap이 끼어들면 안 되기 때문.
---

{
  metrics.length > 0 && (
    <dl class:list={["border-line mt-10 -mb-8 grid grid-cols-2 gap-x-8 gap-y-0 border-t pt-8", cols]} aria-label={t(locale, "project.metrics")}>
      {metrics.map((m) => (
        <div class="row-span-5 grid min-w-0 grid-rows-subgrid pb-8">
          <dt class="text-ink-2 row-start-1 text-sm">{pick(m.label, locale)}</dt>
          {m.before && <dd class="text-ink-2 row-start-2 mt-1 text-sm tabular-nums">{m.before} →</dd>}
          <dd class="row-start-3 mt-2 text-3xl font-semibold tracking-[-0.01em] leading-none whitespace-nowrap tabular-nums">
            {m.after}
            {m.unit && <span class="text-ink-2 ml-1 text-lg font-normal leading-none">{m.unit}</span>}
          </dd>
          <dd class="text-ink-2 row-start-4 mt-3 text-sm">
            {t(locale, "project.method")}: {pick(m.method, locale)}
          </dd>
          {m.evidence && (
            <dd class="row-start-5 mt-1 text-sm">
              <a class="inline-flex min-h-6 items-center py-1 underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={m.evidence}>
                {t(locale, "project.evidence")} →
              </a>
            </dd>
          )}
        </div>
      ))}
    </dl>
  )
}
