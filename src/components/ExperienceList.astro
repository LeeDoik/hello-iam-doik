---
import type { ExperienceData } from "../content/schemas";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { formatPeriod } from "../lib/dates";
import { pick } from "../lib/localized";

interface Props {
  items: ExperienceData[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const kindKey = {
  work: "kind.work",
  education: "kind.education",
  bootcamp: "kind.bootcamp",
} as const;
---

<ol class="mt-10">
  {
    items.map((e) => (
      <li class="border-line border-t py-8 first:border-t-0 first:pt-0">
        <p class="text-ink-2 text-sm tabular-nums">
          {formatPeriod(e.from, e.to, locale)} · {t(locale, kindKey[e.kind])}
        </p>
        <p class="mt-1 font-semibold">
          {pick(e.org, locale)} · {pick(e.role, locale)}
        </p>
        <ul class="text-ink-2 mt-2 max-w-[65ch] list-disc pl-5 text-sm">
          {e.bullets.map((b) => (
            <li>{pick(b, locale)}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
