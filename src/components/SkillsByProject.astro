---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { groupSkills, GROUP_UI_KEY, type SkillRow } from "../lib/skills";
import { localePath } from "../lib/urls";

interface Props {
  rows: SkillRow[];
  locale: Locale;
  /** 프로젝트 slug → 제목(로케일 적용). 링크 텍스트로 쓴다. */
  projectTitles: Map<string, string>;
}
const { rows, locale, projectTitles } = Astro.props;
---

<div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
  {
    groupSkills(rows).map(({ group, skills }) => (
      <section>
        <h3 class="text-ink-2 border-line border-b pb-2 text-sm">{t(locale, GROUP_UI_KEY[group])}</h3>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
          {skills.map((s) => (
            <li class="font-medium">{s.name}</li>
          ))}
        </ul>
        <details class="mt-3">
          <summary class="text-ink-2 cursor-pointer text-sm underline underline-offset-4 decoration-ink-2 hover:decoration-accent">
            {t(locale, "skills.showDetail")}
          </summary>
          <ul class="mt-3 space-y-2">
            {skills.map((s) => (
              <li class="max-w-[65ch]">
                <strong>{s.name}</strong> <span class="text-ink-2">{s.builtWithIt}</span>
                {s.projectSlugs.map((slug) => (
                  <>
                    {" "}
                    <a
                      class="text-ink-2 text-sm underline underline-offset-4 decoration-ink-2 hover:decoration-accent"
                      href={localePath(locale, `/projects/${slug}/`)}
                    >
                      {projectTitles.get(slug) ?? slug}
                    </a>
                  </>
                ))}
              </li>
            ))}
          </ul>
        </details>
      </section>
    ))
  }
</div>
