---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import type { ProjectView } from "../lib/content";
import { formatPeriod } from "../lib/dates";
import { pick } from "../lib/localized";

interface Props {
  project: ProjectView;
  locale: Locale;
  /** 스킬 id → 표시 이름(로케일 적용). 없으면 id를 그대로 보여준다. */
  skillNames?: Map<string, string>;
}
const { project, locale, skillNames } = Astro.props;
const d = project.data;
const statusKey = { live: "status.live", archived: "status.archived", wip: "status.wip" } as const;
const headline = d.metrics[0];
// "볼 수 있는 것" 하나만 고른다: 라이브 > 데모 영상 > 저장소.
const seeIt = d.links.live
  ? { href: d.links.live, key: "project.live" as const }
  : d.links.demoVideo
    ? { href: d.links.demoVideo, key: "project.demoVideo" as const }
    : d.links.repo
      ? { href: d.links.repo, key: "project.repo" as const }
      : undefined;
---

<article
  data-project-card
  data-slug={project.slug}
  data-stack={d.stack.join(" ")}
  class="border-line border-b py-10 md:py-12"
>
  <h3 class="text-xl font-semibold tracking-[-0.01em] leading-[1.3] md:text-2xl">
    <a class="decoration-accent underline-offset-4 hover:underline" href={project.href}>{pick(d.title, locale)}</a>
  </h3>
  <p class="text-ink-2 mt-2 text-sm tabular-nums">
    {formatPeriod(d.period.from, d.period.to, locale)} · {t(locale, statusKey[d.status])}
    {
      seeIt && (
        <>
          {" "}
          ·{" "}
          <a class="underline underline-offset-4 decoration-ink-2 hover:decoration-accent" href={seeIt.href}>
            {t(locale, seeIt.key)}
          </a>
        </>
      )
    }
  </p>
  {
    headline && (
      <>
        <p class="mt-3 text-2xl font-semibold tabular-nums tracking-[-0.01em] leading-none">
          {headline.after}
          {headline.unit && <span class="text-ink-2 ml-1 text-base font-normal">{headline.unit}</span>}
        </p>
        <p class="text-ink-2 mt-1 text-sm">{pick(headline.label, locale)}</p>
      </>
    )
  }
  <p class="mt-4 max-w-[65ch]">{pick(d.summary, locale)}</p>
  <ul class="text-ink-2 mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label={t(locale, "card.stackAria")}>
    {d.stack.map((s) => <li>{skillNames?.get(s) ?? s}</li>)}
  </ul>
</article>
